{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuditEventConfigSettingsCreated",
  "description": "The data structure that represents the event data for a config settings created audit event.\n\nIntroduced in Apple Business API 2.6.",
  "x-apple-developer-api-uri": "https://developer.apple.com/documentation/applebusinessapi/auditeventconfigsettingscreated",
  "x-apple-developer-api-version": "2.6",
  "x-apple-developer-data-uri": "https://developer.apple.com/tutorials/data/documentation/applebusinessapi/auditeventconfigsettingscreated.json",
  "type": "object",
  "properties": {
    "configId": {
      "description": "The unique identifier of an instance of an admin-created Configuration.",
      "type": "string"
    },
    "configType": {
      "description": "The type of the Configuration (e.g. “WiFi”).",
      "examples": [ "WiFi" ],
      "type": "string"
    },
    "configVersion": {
      "description": "The version of the Configuration.",
      "type": "string"
    }
  }
}
