{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DocumentLinks",
  "description": "Self-links to documents that can contain information for one or more resources.\n\nIntroduced in Apple Business API 2.6.",
  "x-apple-developer-api-uri": "https://developer.apple.com/documentation/applebusinessapi/documentlinks",
  "x-apple-developer-api-version": "2.6",
  "x-apple-developer-data-uri": "https://developer.apple.com/tutorials/data/documentation/applebusinessapi/documentlinks.json",
  "type": "object",
  "required": [ "self" ],
  "properties": {
    "self": {
      "description": "The link that produces the current document.",
      "type": "string",
      "format": "uri-reference"
    }
  }
}
