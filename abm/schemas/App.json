{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "App",
  "description": "The data structure that represents an app resource.\n\nApple Business API 2.7+",
  "x-apple-developer-api-uri": "https://developer.apple.com/documentation/applebusinessapi/app",
  "x-apple-developer-api-version": "2.7",
  "x-apple-developer-data-uri": "https://developer.apple.com/tutorials/data/documentation/applebusinessapi/app.json",
  "type": "object",
  "required": [ "id", "type" ],
  "properties": {
    "attributes": {
      "description": "The resource’s attributes.",
      "$ref": "App.Attributes.json"
    },
    "id": {
      "description": "The opaque resource ID that uniquely identifies the resource.",
      "type": "string"
    },
    "links": {
      "description": "Navigational links that include the self-link.",
      "$ref": "ResourceLinks.json"
    },
    "type": {
      "description": "The resource type.",
      "const": "apps"
    }
  }
}
